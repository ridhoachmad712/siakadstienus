# Folder ini berisi template kosong yang memang harus bisa diunduh pengguna,
# jadi larangan dari pages/.htaccess dibatalkan di sini.
<FilesMatch "\.(xls|xlsx|csv)$">
	<IfModule mod_authz_core.c>
		Require all granted
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Allow from all
	</IfModule>
</FilesMatch>
